<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup for Android 11 and lower. See data_extraction_rules.xml for later versions.
   Books are left out: a few of them would pass the 25 MB backup quota, and then nothing would
   be backed up.
-->
<full-backup-content>
    <exclude domain="database" path="books.db" />
    <exclude domain="database" path="books.db-shm" />
    <exclude domain="database" path="books.db-wal" />
    <exclude domain="file" path="books/" />
</full-backup-content>
