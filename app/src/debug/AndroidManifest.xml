<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Exported so adb can reach it; only in debug builds. The adb shell holds DUMP, other
             apps don't. -->
        <receiver
            android:name=".debug.DebugPrefsReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
